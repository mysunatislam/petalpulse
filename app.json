{
  "expo": {
    "name": "Petal & Pulse",
    "slug": "petal-and-pulse",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petalpulse.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your private Petal & Pulse space."
      }
    },
    "android": {
      "package": "com.petalpulse.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7DCE5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SKIN_TEMPERATURE",
        "android.permission.health.READ_BASAL_BODY_TEMPERATURE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private Petal & Pulse space."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D992AA"
        }
      ],
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Petal & Pulse uses the microphone only while you hold the mic button, to turn your words into text.",
          "speechRecognitionPermission": "Your speech is turned into text so you can talk instead of type. Nothing is recorded or saved as audio."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "scheme": "petalpulse",
    "backgroundColor": "#FFF9F5",
    "description": "An AI-powered menstrual, emotional and personalized wellness companion.",
    "experiments": {
      "typedRoutes": false
    }
  }
}
